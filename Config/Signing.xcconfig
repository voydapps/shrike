//  Signing defaults, committed. Without Config/Local.xcconfig the app is signed
//  ad-hoc, so a fresh clone builds. Copy Local.xcconfig.example to
//  Local.xcconfig (git-ignored) to sign with your own certificate.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
CODE_SIGN_IDENTITY[sdk=macosx*] = -

#include? "Local.xcconfig"
